{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "case_id",
    "case_family",
    "version",
    "target_action",
    "human_visible_case_prompt",
    "stipulated_facts",
    "stakeholders",
    "author_reference_status",
    "author_expected_gate_disposition"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-F][12]$"
    },
    "case_family": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "version": {
      "const": "2.0.0"
    },
    "target_action": {
      "type": "string",
      "minLength": 3
    },
    "human_visible_case_prompt": {
      "type": "string",
      "minLength": 100
    },
    "stipulated_facts": {
      "type": "string",
      "minLength": 50
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "author_reference_status": {
      "enum": [
        "PROHIBITED",
        "JUSTIFIED",
        "DISPUTED"
      ]
    },
    "author_expected_gate_disposition": {
      "enum": [
        "ALLOW",
        "DENY",
        "REVIEW"
      ]
    }
  },
  "additionalProperties": true
}
